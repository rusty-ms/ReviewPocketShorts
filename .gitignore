# Secrets - NEVER commit these
.env
client_secret.json
youtube_token.json
*.token
*.pem
*.key

# Runtime data
# NOTE: data/used_products.json and data/product_catalog.json are intentionally
# NOT ignored — GitHub Actions runners are ephemeral (fresh checkout every run),
# so dedup/catalog state must be committed back to the repo to persist at all.
# See the "Commit dedup state" step in .github/workflows/amazon_video_bot.yml.
temp/
output/
logs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
*.egg-info/
dist/
build/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
